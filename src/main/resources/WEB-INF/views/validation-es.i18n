acme.validation.header.message = El encabezado debe contener entre 1 y 75 caracteres.
acme.validation.text.message = El texto debe contener entre 1 y 255 caracteres.
acme.validation.ticker.message = El formato es incorrecto.

#sponsorships
acme.validation.sponsorship.null-draft-mode.message = El valor del atributo "draft-mode" no puede ser nulo.
acme.validation.sponsorship.invalid-interval.message = El intervalo de tiempo es incorrecto.
acme.validation.sponsorship.no-donations.message = El patrocinio debe tener al menos una Donacion.

#strategies
acme.validation.strategy.hastactic.message = La estrategia tiene que tener al menos 1 táctica para ser publicada
acme.validation.strategy.duplicated.message = Este ticker ya está en uso, prueba uno diferente
acme.validation.strategy.start-past.message = La fecha de inicio no puede ser en el pasado
acme.validation.strategy.end-past.message = La fecha del final no puede ser en el pasado
acme.validation.strategy.end-before-start.message = La fecha del final tiene que ser posterior a la de inicio